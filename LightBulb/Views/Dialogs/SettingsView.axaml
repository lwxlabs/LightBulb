<UserControl
  x:Class="LightBulb.Views.Dialogs.SettingsView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:LightBulb.Converters"
  xmlns:dialogs="clr-namespace:LightBulb.ViewModels.Dialogs"
  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
  MinWidth="560"
  MinHeight="420"
  HorizontalAlignment="Stretch"
  VerticalAlignment="Stretch"
  x:DataType="dialogs:SettingsViewModel"
>
  <Grid ColumnDefinitions="Auto,*">
    <!--  Settings tab selection  -->
    <Border
      Grid.Column="0"
      Width="190"
      VerticalAlignment="Stretch"
      Background="{DynamicResource ForkPanelBrush}"
    >
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderThickness="0,0,2,0" Classes.active="{Binding IsActive}">
              <Border.Styles>
                <Style Selector="Border.active">
                  <Setter
                    Property="BorderBrush"
                    Value="{DynamicResource MaterialSecondaryMidBrush}"
                  />
                </Style>
              </Border.Styles>
              <Button
                Margin="4"
                Padding="10,8"
                HorizontalContentAlignment="Stretch"
                Command="{Binding $parent[UserControl].((dialogs:SettingsViewModel)DataContext).ActivateTabCommand}"
                CommandParameter="{Binding}"
                Foreground="{DynamicResource ForkTextBrush}"
                Theme="{DynamicResource MaterialFlatButton}"
                ToolTip.Tip="{Binding DisplayName}"
              >
                <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                  <materialIcons:MaterialIcon
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    VerticalAlignment="Center"
                    Kind="{Binding Converter={x:Static converters:SettingsTabToMaterialIconKindConverter.Instance}}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis"
                  />
                </Grid>
              </Button>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid
      Grid.Column="1"
      Background="{DynamicResource ForkBackgroundBrush}"
      RowDefinitions="*,Auto,Auto"
    >
      <!--  Active settings tab  -->
      <ScrollViewer
        Grid.Row="0"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto"
      >
        <ContentControl Margin="0,0,8,16" HorizontalAlignment="Stretch" Content="{Binding ActiveTab}" />
      </ScrollViewer>

      <!--  Separator  -->
      <Rectangle
        Grid.Row="1"
        Height="1"
        HorizontalAlignment="Stretch"
        Fill="{DynamicResource ForkBorderBrush}"
      />

      <!--  Buttons  -->
      <UniformGrid Grid.Row="2" Margin="4" Columns="3">
        <!--  Reset  -->
        <Button
          Margin="4"
          HorizontalContentAlignment="Stretch"
          Command="{Binding ResetCommand}"
          Theme="{DynamicResource MaterialFlatButton}"
          ToolTip.Tip="{Binding LocalizationManager.ResetTooltip}"
        >
          <TextBlock
            Text="{Binding LocalizationManager.ResetButton}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
        </Button>

        <!--  Cancel  -->
        <Button
          Margin="4"
          HorizontalContentAlignment="Stretch"
          Command="{Binding CancelCommand}"
          IsCancel="True"
          Theme="{DynamicResource MaterialFlatButton}"
          ToolTip.Tip="{Binding LocalizationManager.CancelButton}"
        >
          <TextBlock
            Text="{Binding LocalizationManager.CancelButton}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
        </Button>

        <!--  Save  -->
        <Button
          Margin="4"
          HorizontalContentAlignment="Stretch"
          Command="{Binding SaveCommand}"
          IsDefault="True"
          Theme="{DynamicResource MaterialFlatButton}"
          ToolTip.Tip="{Binding LocalizationManager.SaveButton}"
        >
          <TextBlock
            Text="{Binding LocalizationManager.SaveButton}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
        </Button>
      </UniformGrid>
    </Grid>
  </Grid>
</UserControl>
