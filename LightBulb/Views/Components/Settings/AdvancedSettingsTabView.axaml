<UserControl
  x:Class="LightBulb.Views.Components.Settings.AdvancedSettingsTabView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:LightBulb.Converters"
  xmlns:settings="clr-namespace:LightBulb.ViewModels.Components.Settings"
  x:DataType="settings:AdvancedSettingsTabViewModel"
>
  <StackPanel Margin="16" Orientation="Vertical" Spacing="16">
    <!--  Language  -->
    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding LocalizationManager.LanguageTooltip}">
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.LanguageLabel}"
        TextWrapping="Wrap"
      />
      <ComboBox
        Grid.Column="1"
        ItemsSource="{Binding AvailableLanguages}"
        SelectedItem="{Binding Language}"
      >
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static converters:LanguageToStringConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!--  Auto start  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.StartWithWindowsTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.StartWithWindowsLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStartEnabled}" />
    </Grid>

    <!--  Start minimized  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.StartMinimizedTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.StartMinimizedLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsStartMinimizedEnabled}" />
    </Grid>

    <!--  Tray left click action  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.TrayLeftClickActionTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.TrayLeftClickActionLabel}"
        TextWrapping="Wrap"
      />
      <ComboBox
        Grid.Column="1"
        MinWidth="220"
        ItemsSource="{Binding AvailableTrayLeftClickActions}"
        SelectedItem="{Binding TrayLeftClickAction}"
      >
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static converters:TrayLeftClickActionToStringConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!--  Default to day time  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.DefaultToDayConfigTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.DefaultToDayConfigLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDefaultToDayConfigurationEnabled}" />
    </Grid>

    <!--  Master LightBulb switch: same runtime state used by the tray and Toggle shortcut  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.LightBulbEnabledTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.LightBulbEnabledLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsLightBulbEnabled}" />
    </Grid>

    <!--  Day/night schedule  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.DayNightCycleTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.DayNightCycleLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDayNightCycleEnabled}" />
    </Grid>

    <!--  Pause when full screen  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.PauseWhenFullscreenTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.PauseWhenFullscreenLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPauseWhenFullScreenEnabled}" />
    </Grid>

    <!--  Configuration smoothing  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.GammaSmoothingTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.GammaSmoothingLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsConfigurationSmoothingEnabled}" />
    </Grid>

    <!--  Gamma polling  -->
    <Grid
      ColumnDefinitions="*,Auto"
      ToolTip.Tip="{Binding LocalizationManager.GammaPollingTooltip}"
    >
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="{Binding LocalizationManager.GammaPollingLabel}"
        TextWrapping="Wrap"
      />
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsGammaPollingEnabled}" />
    </Grid>


    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding LocalizationManager.TrayTemperatureStepTooltip}">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding LocalizationManager.TrayTemperatureStepLabel}" TextWrapping="Wrap" />
      <TextBox Grid.Column="1" Width="72" Text="{Binding TrayTemperatureWheelStep, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}" Theme="{DynamicResource CompactTextBox}" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding LocalizationManager.TrayBrightnessStepTooltip}">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding LocalizationManager.TrayBrightnessStepLabel}" TextWrapping="Wrap" />
      <TextBox Grid.Column="1" Width="72" Text="{Binding TrayBrightnessWheelStep, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}" Theme="{DynamicResource CompactTextBox}" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding LocalizationManager.TrayColorWheelModifierTooltip}">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding LocalizationManager.TrayColorWheelModifierLabel}" TextWrapping="Wrap" />
      <ComboBox Grid.Column="1" MinWidth="110" ItemsSource="{Binding AvailableTrayWheelModifiers}" SelectedItem="{Binding TrayColorWheelModifier}" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding LocalizationManager.TrayWheelModifierTooltip}">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding LocalizationManager.TrayWheelModifierLabel}" TextWrapping="Wrap" />
      <ComboBox Grid.Column="1" MinWidth="110" ItemsSource="{Binding AvailableTrayWheelModifiers}" SelectedItem="{Binding TrayBrightnessWheelModifier}" />
    </Grid>

    <TextBlock FontSize="11" Opacity="0.7" Text="{Binding LocalizationManager.TrayFineWheelHint}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
