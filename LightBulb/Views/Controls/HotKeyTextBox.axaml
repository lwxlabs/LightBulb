<UserControl
  x:Class="LightBulb.Views.Controls.HotKeyTextBox"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid ColumnDefinitions="*,28" ColumnSpacing="4">
    <TextBox
      x:Name="TextBox"
      Grid.Column="0"
      IsReadOnly="True"
      IsUndoEnabled="False"
      TextAlignment="Center"
      Theme="{DynamicResource CompactTextBox}"
    />
    <Button
      x:Name="ResetButton"
      Grid.Column="1"
      Padding="0"
      Click="ResetButton_OnClick"
      Content="×"
      FontSize="16"
      Theme="{DynamicResource MaterialFlatButton}"
      ToolTip.Tip="Clear shortcut"
    />
  </Grid>
</UserControl>
