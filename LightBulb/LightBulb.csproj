<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../favicon.ico</ApplicationIcon>
    <PublishTrimmed>true</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="../favicon.ico" Link="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="LwXLabs.Localite" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CSharpier.MsBuild" PrivateAssets="all" />
    <PackageReference Include="DialogHost.Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Material.Avalonia" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="PowerKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LightBulb.Core/LightBulb.Core.csproj" />
    <ProjectReference Include="../LightBulb.PlatformInterop/LightBulb.PlatformInterop.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- sqlite-net maps Localite's database rows using reflection. Keep its mapping metadata. -->
    <TrimmerRootAssembly Include="Localite" />
    <TrimmerRootAssembly Include="SQLite-net" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgLwXLabs_Localite)' != ''">
    <None Include="$(PkgLwXLabs_Localite)/LICENSE.txt" Link="Licenses/Localite/LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgLwXLabs_Localite)/NOTICE.txt" Link="Licenses/Localite/NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgLwXLabs_Localite)/THIRD-PARTY-NOTICES.txt" Link="Licenses/Localite/THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
